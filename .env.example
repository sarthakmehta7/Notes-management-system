# =========================
# Server
# =========================
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# =========================
# Email OTP (required for registration and login)
# Gmail: enable 2-Step Verification and create a 16-character App Password.
# Then use smtp.gmail.com on port 465 with SMTP_SECURE=true.
# =========================
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: only allow a college email domain, e.g. sliet.ac.in
# Leave blank to allow any valid email.
ALLOWED_EMAIL_DOMAIN=

# =========================
# Admin
# =========================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# =========================
# Production PostgreSQL
# =========================
# Put your Supabase/PostgreSQL connection string here to use PostgreSQL.
# Leave blank to use local SQLite for development.
DATABASE_URL=

# =========================
# Supabase Storage
# =========================
# Required for cloud file storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=notes

# Max file upload size
MAX_FILE_SIZE_MB=25
